# Copy this file to .env and fill in local values. Never commit the real .env file.

# Local Neo4j connection (Contract 4 / Week 4 storage layer)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Bounded timeouts and retry behavior (all values in seconds unless noted)
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=15
NEO4J_TRANSACTION_TIMEOUT_SECONDS=10

# Model provider: openrouter (default) or ollama
GRAPH_RAG_PROVIDER=openrouter

# GraphRAG text splitting (characters; overlap must be less than chunk size)
GRAPH_RAG_CHUNK_SIZE=10000
GRAPH_RAG_CHUNK_OVERLAP=0

# Ollama configuration (used when GRAPH_RAG_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenRouter configuration
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_LLM_MAX_TOKENS=4096
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=true
