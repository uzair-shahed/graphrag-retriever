# Copy this file to .env and fill in local values. Never commit the real .env file.

# Local Neo4j connection (Contract 4 / Week 4 storage layer)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Bounded timeouts and retry behavior (all values in seconds unless noted)
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=15
NEO4J_TRANSACTION_TIMEOUT_SECONDS=10

# Neo4j GraphRAG vector index contract. Verify this existing index before QA.
GRAPH_RAG_VECTOR_INDEX_NAME=chunk_embedding
GRAPH_RAG_VECTOR_INDEX_LABEL=Chunk
GRAPH_RAG_VECTOR_PROPERTY=embedding
GRAPH_RAG_VECTOR_SIMILARITY=cosine
# OpenRouter text-embedding-3-small uses 1536; Ollama nomic-embed-text uses 768.
# Keep this value aligned with the embedding model and Neo4j vector index.
GRAPH_RAG_VECTOR_DIMENSIONS=1536

# Model provider: openrouter (default) or ollama
GRAPH_RAG_PROVIDER=openrouter

# GraphRAG text splitting (characters; overlap must be less than chunk size)
GRAPH_RAG_CHUNK_SIZE=10000
GRAPH_RAG_CHUNK_OVERLAP=0

# Ollama configuration (used when GRAPH_RAG_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_LLM_MAX_TOKENS=4096
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenRouter configuration
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_LLM_MAX_TOKENS=4096
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=true

# Independent RAGAS judge (defaults to GRAPH_RAG_PROVIDER when unset).
# Empty model/endpoint overrides reuse the selected provider's settings above.
RAGAS_PROVIDER=ollama
RAGAS_LLM_MODEL=
RAGAS_EMBEDDING_MODEL=
RAGAS_BASE_URL=
RAGAS_MAX_TOKENS=4096
RAGAS_TIMEOUT_SECONDS=180
RAGAS_RETRIES=2
