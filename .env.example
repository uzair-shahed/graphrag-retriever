# Copy this file to .env and fill in local values. Never commit the real .env file.

# Local Neo4j connection (Contract 4 / Week 4 storage layer)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Bounded timeouts and retry behavior (all values in seconds unless noted)
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=15
NEO4J_TRANSACTION_TIMEOUT_SECONDS=10
