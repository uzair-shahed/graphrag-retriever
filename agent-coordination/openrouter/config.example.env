# Copy these values into the repository root .env file.
# Never commit the real .env or expose the API key in logs or chat.

# OpenRouter API
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Initial free, structured-output-capable extraction baseline.
# Re-check current catalog availability before each integration run.
OPENROUTER_LLM_MODEL=qwen/qwen3.8-27b:free

# Initial free text embedding baseline.
# This model is documented by OpenRouter as 1,024-dimensional with a 512-token context.
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_EMBEDDING_DIMENSIONS=1024

# First-run routing and privacy policy.
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_DATA_COLLECTION=deny

# Optional OpenRouter application identification headers.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=musique-graphrag
