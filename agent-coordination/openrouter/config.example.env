# Copy these values into the repository root .env file.
# Never commit the real .env or expose the API key in logs or chat.

# OpenRouter API
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ultra-low cost, high-throughput extraction model (bypasses free tier rate limits)
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini

# Ultra-low cost, highly stable 1024-dimension embedding model ($0.02 / 1M tokens)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536

# First-run routing and privacy policy.
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_DATA_COLLECTION=deny

# Optional OpenRouter application identification headers.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=musique-graphrag